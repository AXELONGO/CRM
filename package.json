{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "auth:bootstrap-local": "tsx --env-file=.env.local scripts/bootstrap-local-user.ts",
    "platform:bootstrap-admin": "tsx --env-file=.env.local scripts/bootstrap-platform-admin.ts",
    "sales:provision-default-pipelines": "tsx --env-file=.env.local scripts/provision-default-pipelines.ts",
    "worker:integrations": "tsx --env-file=.env.local scripts/integration-worker.ts",
    "worker:automation": "tsx --env-file=.env.local scripts/automation-worker.ts",
    "worker": "pnpm worker:integrations",
    "test:worker": "vitest run tests/security/repro-worker-queue.test.ts --config tests/security/vitest.config.ts",
    "backup:db": "bash scripts/operations/backup-db.sh",
    "backup:verify": "bash scripts/operations/verify-db-backup.sh",
    "backup:restore-local": "bash scripts/operations/restore-db-local.sh",
    "release:manifest": "bash scripts/operations/create-release-manifest.sh",
    "security:check": "tsx scripts/operations/security-check.ts",
    "security:actions": "tsx scripts/operations/actions-audit.ts",
    "security:rls-audit": "tsx scripts/operations/rls-audit.ts",
    "security:supply-chain": "tsx scripts/operations/supply-chain-report.ts",
    "backup:test": "tsx scripts/operations/backup-test.ts",
    "restore:test": "tsx scripts/operations/restore-drill.ts",
    "test:integration": "pnpm test:run",
    "load:test:smoke": "tsx scripts/performance/load-smoke.ts",
    "test:security-repro": "vitest run --config tests/security/vitest.config.ts",
    "auth:e2e-prepare": "tsx scripts/wait-for-test-dependencies.ts && drizzle-kit migrate",
    "test:e2e": "playwright test",
    "test:e2e:mfa": "E2E_MFA_ENFORCEMENT=true playwright test tests/e2e/mfa.spec.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.27",
    "@react-pdf/renderer": "4.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.6.27",
    "drizzle-orm": "0.45.2",
    "imapflow": "1.6.6",
    "next": "16.3.0",
    "nodemailer": "9.0.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "auth": "1.6.27",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=CRM
DATABASE_URL=postgresql://crm_runtime:crm_runtime_password@localhost:5432/crm_dev
DATABASE_MIGRATION_URL=postgresql://crm_migration:crm_migration_password@localhost:5432/crm_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
AUTH_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
MFA_ENFORCEMENT_ENABLED=true
TENANT_INVITATION_TTL_HOURS=168
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=CRM Local <no-reply@crm.local>
STORAGE_DRIVER=filesystem
FILE_STORAGE_PATH=./.local-storage
DATABASE_INGRESS_URL=postgresql://crm_ingress:crm_ingress_password@localhost:5432/crm_dev
DATABASE_WORKER_URL=postgresql://crm_worker:crm_worker_password@localhost:5432/crm_dev
INTEGRATION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
INTEGRATION_ENCRYPTION_KEY_VERSION=1
PUBLIC_FORM_SIGNING_KEY=replace-with-independent-key
INTEGRATION_WORKER_POLL_MS=1000
INTEGRATION_JOB_BATCH_SIZE=10
INTEGRATION_JOB_LEASE_SECONDS=300
AUTOMATION_WORKER_POLL_MS=1000
AUTOMATION_JOB_BATCH_SIZE=10
AUTOMATION_JOB_LEASE_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=1048576
INBOUND_RECEIPT_RETENTION_DAYS=7
ALLOW_LOCAL_INTEGRATION_HOSTS=false
AGREEMENT_CHALLENGE_HMAC_KEY=replace-with-independent-32-byte-key
QUOTE_CHALLENGE_HMAC_KEY=replace-with-independent-32-byte-key
OTP_DELIVERY_ENCRYPTION_KEY=replace-with-32-byte-base64-key
OTP_DELIVERY_ENCRYPTION_KEY_VERSION=1
AGREEMENT_CHALLENGE_KEY_VERSION=1
AGREEMENT_EVIDENCE_HMAC_KEY=replace-with-independent-32-byte-key
AGREEMENT_EVIDENCE_KEY_VERSION=1
AGREEMENT_PUBLIC_SESSION_MINUTES=60
AGREEMENT_CHALLENGE_MINUTES=10
AGREEMENT_RECENT_AUTH_MINUTES=15
AGREEMENT_DEFAULT_ENVELOPE_DAYS=15
AGREEMENT_EXTERNAL_UPLOAD_MAX_BYTES=15728640
AGREEMENT_MALWARE_SCANNER=none
MERCADO_PAGO_ADAPTER_ENABLED=true
MERCADO_PAGO_LIVE_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=fake
MERCADO_PAGO_OAUTH_CLIENT_ID=fake-client-id
MERCADO_PAGO_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/mercado-pago/oauth/callback
PAYMENTS_RETURN_ORIGIN=http://localhost:3000
STRIPE_ADAPTER_ENABLED=true
STRIPE_LIVE_ENABLED=false
STRIPE_ENVIRONMENT=fake
STRIPE_CONNECT_CLIENT_ID=ca_fake_crm
STRIPE_CONNECT_REDIRECT_URI=http://localhost:3000/api/integrations/stripe/oauth/callback
PAYPAL_ADAPTER_ENABLED=true
PAYPAL_LIVE_ENABLED=false
PAYPAL_ENVIRONMENT=fake
PAYPAL_PLATFORM_APPROVAL_STATUS=sandbox_ready
